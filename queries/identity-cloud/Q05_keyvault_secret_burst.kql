// Q05: Ráfagas de lectura de secretos, claves o certificados en varios Key Vault
// MITRE ATT&CK: T1555.006, T1552
// Nota: Si usas tablas específicas de recurso (AZKVAuditLogs), valida el esquema con | getschema.

let lookback = 24h;
let window = 10m;
let minVaults = 2;
let minOps = 10;
AzureDiagnostics
| where TimeGenerated >= ago(lookback)
| where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
| where OperationName in ("SecretGet", "SecretList", "KeyGet", "KeyList", "CertificateGet", "CertificateList")
| extend
    CallerIP = tostring(column_ifexists("CallerIPAddress", "")),
    AppId = tostring(column_ifexists("identity_claim_appid_g", "")),
    HttpStatus = toint(column_ifexists("httpStatusCode_d", 0))
| summarize
    Ops = count(),
    Vaults = dcount(Resource),
    Denied = countif(HttpStatus in (401, 403)),
    Operations = make_set(OperationName, 8)
    by CallerIP, AppId, bin(TimeGenerated, window)
| where Vaults >= minVaults and Ops >= minOps
| order by Ops desc
