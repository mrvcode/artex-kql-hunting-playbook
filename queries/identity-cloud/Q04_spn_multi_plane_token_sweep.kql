// Q04: Un service principal pidiendo tokens para ARM, Key Vault, Storage y Graph
// MITRE ATT&CK: T1580, T1087.004, T1530

let lookback = 24h;
let window = 15m;
let minClasses = 3;
AADServicePrincipalSignInLogs
| where TimeGenerated >= ago(lookback)
| where ResultType == "0"
| extend ResourceClass = case(
    ResourceDisplayName has_any ("Service Management", "Resource Manager"), "ARM",
    ResourceDisplayName has "Key Vault", "KeyVault",
    ResourceDisplayName has "Storage", "Storage",
    ResourceDisplayName has "Graph", "Graph",
    ""
)
| where isnotempty(ResourceClass)
| summarize
    Classes = dcount(ResourceClass),
    ClassList = make_set(ResourceClass),
    IPs = make_set(IPAddress, 5),
    Events = count()
    by ServicePrincipalId, ServicePrincipalName, bin(TimeGenerated, window)
| where Classes >= minClasses
| order by TimeGenerated desc
