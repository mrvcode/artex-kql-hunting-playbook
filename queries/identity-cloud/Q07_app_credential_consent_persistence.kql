// Q07: Nuevas credenciales o consentimientos en aplicaciones (persistencia)
// MITRE ATT&CK: T1098.001, T1528

let lookback = 7d;
AuditLogs
| where TimeGenerated >= ago(lookback)
| where OperationName has_any (
    "Add service principal credentials",
    "Certificates and secrets management",
    "Consent to application"
)
| where Result == "success"
| extend
    ActorUser = tostring(InitiatedBy.user.userPrincipalName),
    ActorApp = tostring(InitiatedBy.app.displayName),
    ActorIP = tostring(InitiatedBy.user.ipAddress),
    Target = tostring(TargetResources[0].displayName)
| extend ChangedByApp = isnotempty(ActorApp)
| project
    TimeGenerated,
    OperationName,
    Target,
    ActorUser,
    ActorApp,
    ActorIP,
    ChangedByApp,
    CorrelationId
| order by ChangedByApp desc, TimeGenerated desc
