// Q13: Cadencia de máquina (intervalos medianos muy cortos entre peticiones a múltiples rutas)
// MITRE ATT&CK: T1595, T1190

let lookback = 1h;
let minReq = 100;
let minUris = 20;
let maxMedianGapMs = 1500;
W3CIISLog
| where TimeGenerated >= ago(lookback)
| where not(csUriStem matches regex @"(?i)\.(css|js|png|jpeg|jpg|gif|svg|ico|woff2?)$")
| project TimeGenerated, cIP, csUriStem, scStatus
| order by cIP asc, TimeGenerated asc
| extend GapMs = iff(
    cIP == prev(cIP),
    datetime_diff("millisecond", TimeGenerated, prev(TimeGenerated)),
    long(null)
)
| summarize
    Req = count(),
    P50GapMs = percentile(GapMs, 50),
    P95GapMs = percentile(GapMs, 95),
    Uris = dcount(csUriStem),
    Err4xx = countif(scStatus between (400 .. 499))
    by cIP
| where Req >= minReq and Uris >= minUris and P50GapMs < maxMedianGapMs
| order by Req desc
