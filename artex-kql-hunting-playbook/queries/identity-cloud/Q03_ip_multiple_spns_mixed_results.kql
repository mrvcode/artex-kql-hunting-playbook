// Q03: Una IP autenticándose contra varios service principals con resultados mixtos
// MITRE ATT&CK: T1078.004, T1110

let lookback = 24h;
let window = 30m;
let minSPNs = 3;
let KnownEgress = dynamic(["203.0.113.0/24"]); // Sustituir por rangos corporativos propios
AADServicePrincipalSignInLogs
| where TimeGenerated >= ago(lookback)
| where not(coalesce(ipv4_is_in_any_range(IPAddress, KnownEgress), false))
| summarize
    SPNs = dcount(ServicePrincipalId),
    Failures = countif(ResultType != "0"),
    Successes = countif(ResultType == "0"),
    ErrorCodes = make_set(ResultType, 10),
    Apps = make_set(ServicePrincipalName, 10)
    by IPAddress, bin(TimeGenerated, window)
| where SPNs >= minSPNs and Failures > 0 and Successes > 0
| order by SPNs desc
