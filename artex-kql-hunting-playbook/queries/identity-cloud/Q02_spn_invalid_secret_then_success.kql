// Q02: Secreto de aplicación inválido o caducado seguido de inicio de sesión correcto
// MITRE ATT&CK: T1552.001, T1078.004
// Códigos: ResultType 7000215 = secreto inválido, 7000222 = secreto caducado.

let lookback = 7d;
let maxGap = 1h;
let Fails = AADServicePrincipalSignInLogs
    | where TimeGenerated >= ago(lookback)
    | where ResultType in ("7000215", "7000222")
    | project FailTime = TimeGenerated, ServicePrincipalId, ServicePrincipalName, AppId, IPAddress, ResultType;
let Successes = AADServicePrincipalSignInLogs
    | where TimeGenerated >= ago(lookback)
    | where ResultType == "0"
    | project SuccessTime = TimeGenerated, ServicePrincipalId, IPAddress, ResourceDisplayName;
Fails
| join kind=inner Successes on ServicePrincipalId, IPAddress
| where SuccessTime between (FailTime .. (FailTime + maxGap))
| summarize
    Failures = count(),
    FirstFail = min(FailTime),
    FirstSuccess = min(SuccessTime),
    Resources = make_set(ResourceDisplayName, 10)
    by ServicePrincipalId, ServicePrincipalName, AppId, IPAddress
| order by FirstSuccess desc
