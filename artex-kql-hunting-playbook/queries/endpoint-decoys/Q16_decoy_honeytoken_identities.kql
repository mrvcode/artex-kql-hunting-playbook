// Q16: Acceso o intento de autenticación contra identidades señuelo (honeytokens)
// MITRE ATT&CK: T1078.004, T1552
// Prerrequisito: Watchlist 'DecoyIdentities' con ServicePrincipalId, AppId o UPN en SearchKey.

let lookback = 24h;
let Decoys = toscalar(_GetWatchlist('DecoyIdentities') | summarize make_set(SearchKey));
union isfuzzy=true
    (AADServicePrincipalSignInLogs
    | where TimeGenerated >= ago(lookback)
    | where ServicePrincipalId in (Decoys) or AppId in (Decoys)
    | project
        TimeGenerated,
        Source = "SPN sign-in",
        Actor = ServicePrincipalName,
        IP = IPAddress,
        Detail = strcat("ResultType=", ResultType)),
    (SigninLogs
    | where TimeGenerated >= ago(lookback)
    | where UserPrincipalName in (Decoys)
    | project
        TimeGenerated,
        Source = "User sign-in",
        Actor = UserPrincipalName,
        IP = IPAddress,
        Detail = strcat("ResultType=", ResultType))
| order by TimeGenerated desc
