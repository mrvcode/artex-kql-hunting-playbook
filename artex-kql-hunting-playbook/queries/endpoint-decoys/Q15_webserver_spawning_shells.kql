// Q15: Proceso del servidor web lanzando shells, intérpretes o herramientas de red
// MITRE ATT&CK: T1505.003, T1059.004
// Compatible con Defender XDR Advanced Hunting (incluye Timestamp y ReportId) y Sentinel.

let lookback = 7d;
DeviceProcessEvents
| where Timestamp >= ago(lookback)
| where InitiatingProcessFileName startswith "php"
    or InitiatingProcessFileName in~ ("apache2", "httpd", "nginx", "w3wp.exe", "php-cgi.exe")
| where FileName in~ (
    "sh", "bash", "dash", "zsh",
    "curl", "wget", "nc", "ncat",
    "python", "python3", "perl",
    "cmd.exe", "powershell.exe", "pwsh",
    "whoami", "id", "uname", "certutil.exe"
)
| project
    Timestamp,
    DeviceId,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    FileName,
    ProcessCommandLine,
    ReportId
| order by Timestamp desc
