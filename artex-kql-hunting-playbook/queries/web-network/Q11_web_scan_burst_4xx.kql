// Q11: Ráfaga de escaneo web (amplitud de rutas y alta tasa de errores 4xx)
// MITRE ATT&CK: T1595.002, T1190

let lookback = 24h;
let window = 5m;
let minReq = 60;
let minUris = 25;
let min4xxRatio = 0.5;
W3CIISLog
| where TimeGenerated >= ago(lookback)
| summarize
    Req = count(),
    Uris = dcount(csUriStem),
    Err4xx = countif(scStatus between (400 .. 499)),
    Methods = make_set(csMethod, 6),
    UAs = dcount(csUserAgent)
    by cIP, sSiteName, bin(TimeGenerated, window)
| extend ErrRatio = round(todouble(Err4xx) / Req, 2)
| where Req >= minReq and Uris >= minUris and ErrRatio >= min4xxRatio
| order by Req desc
